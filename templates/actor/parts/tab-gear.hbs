    <div class="box wealth">
      <h3 class="box-title">Wealth</h3>
      <div class="coin-row">
        <label class="coin"><span>Platinum</span><input type="number" name="system.money.pp" value="{{coins.pp}}" data-dtype="Number"></label>
        <label class="coin"><span>Gold</span><input type="number" name="system.money.gp" value="{{coins.gp}}" data-dtype="Number"></label>
        <label class="coin"><span>Electrum</span><input type="number" name="system.money.ep" value="{{coins.ep}}" data-dtype="Number"></label>
        <label class="coin"><span>Silver</span><input type="number" name="system.money.sp" value="{{coins.sp}}" data-dtype="Number"></label>
        <label class="coin"><span>Copper</span><input type="number" name="system.money.cp" value="{{coins.cp}}" data-dtype="Number"></label>
      </div>
      <p class="coin-caption">Carried (counts toward encumbrance)</p>
      <div class="coin-row coin-stored">
        <label class="coin"><span>Platinum</span><input type="number" name="system.moneyStored.pp" value="{{system.moneyStored.pp}}" data-dtype="Number"></label>
        <label class="coin"><span>Gold</span><input type="number" name="system.moneyStored.gp" value="{{system.moneyStored.gp}}" data-dtype="Number"></label>
        <label class="coin"><span>Electrum</span><input type="number" name="system.moneyStored.ep" value="{{system.moneyStored.ep}}" data-dtype="Number"></label>
        <label class="coin"><span>Silver</span><input type="number" name="system.moneyStored.sp" value="{{system.moneyStored.sp}}" data-dtype="Number"></label>
        <label class="coin"><span>Copper</span><input type="number" name="system.moneyStored.cp" value="{{system.moneyStored.cp}}" data-dtype="Number"></label>
      </div>
      <p class="coin-caption">Stored elsewhere (bank, home, hidden; does not count)</p>
      <label class="fld wide"><span>Other treasure notes</span><input type="text" name="system.treasure" value="{{system.treasure}}"></label>
    </div>
    <div class="box magic-list">
      <h3 class="box-title">Magic Items <span class="necklace-art gold-only" aria-hidden="true"></span>
        <button type="button" class="mini" data-action="itemCreate" data-type="magic" title="Add magic item"><i class="fa-solid fa-plus"></i></button>
      </h3>
      <table class="ledger">
        <thead><tr><th class="left">Item</th><th class="left">Kind</th><th>Location</th><th>Qty / Charges</th><th></th><th></th></tr></thead>
        <tbody>
        {{#each magicItems}}
        <tr data-item-id="{{id}}" class="{{#if s.equipped}}worn{{/if}}">
          <td class="left"><a data-action="itemEdit">{{name}}</a>{{#if s.usable}} <span class="hint">({{s.usable}})</span>{{/if}}{{#if weaponMissing}} <button type="button" class="icon-btn" data-action="magicWeapon" title="Add its weapon form to the Weapons list"><i class="fa-solid fa-khanda"></i></button>{{/if}}{{#if cont}}<span class="sub-note cont-load {{#if cont.over}}over{{/if}}" title="{{cont.contents}}">holds {{cont.loadText}}{{#if cont.over}}: over capacity{{/if}}</span>{{/if}}{{#if found}}<span class="sub-note found-note" title="Rolled once when found; kept">{{found}}</span>{{/if}}</td>
          <td class="left hint">{{cat}}{{#if s.protection.kind}} · {{#if (adnd-eq s.protection.kind "bracers")}}AC {{s.protection.ac}}{{else}}+{{s.protection.ac}} AC / +{{s.protection.save}} saves{{/if}}{{/if}}{{#if s.ammo}} · {{adnd-signed s.bonus.hit}}{{/if}}</td>
          <td>{{> "systems/frpg1e/templates/actor/parts/loc-select.hbs" opts=locOpts}}</td>
          <td class="num">
            {{#if charged}}<span class="charges-text" title="Change charges on the item's sheet (click its name)">{{s.charges.value}}{{#if s.charges.max}} / {{s.charges.max}}{{/if}}</span>
            {{else}}{{#if stack}}<input type="number" class="w3" data-item-field="system.quantity" data-dtype="Number" value="{{s.quantity}}">{{/if}}{{/if}}
          </td>
          <td>{{#unless (adnd-eq s.category "ammunition")}}<button type="button" class="cast-btn" data-action="magicUse">{{useLabel}}</button>{{/unless}}</td>
          <td><button type="button" class="icon-btn" data-action="itemDelete"><i class="fa-solid fa-trash"></i></button></td>
        </tr>
        {{else}}<tr><td colspan="6" class="hint">Drag magic items here from the Magic Items (DMG/UA) compendium.</td></tr>{{/each}}
        </tbody>
      </table>
      {{#if protection.notes.length}}<p class="hint">{{#each protection.notes}}{{this}}. {{/each}}</p>{{/if}}
    </div>

    <div class="box treasure-list">
      <h3 class="box-title">Gems, Jewelry &amp; Valuables <span class="hint">total {{treasureTotal}} gp</span>
        <button type="button" class="mini" data-action="itemCreate" data-type="treasure" title="Add treasure"><i class="fa-solid fa-plus"></i></button>
      </h3>
      <table class="ledger">
        <thead><tr><th class="left">Item</th><th class="left">Kind</th><th>Location</th><th>Qty</th><th>Value each (gp)</th><th>Total</th><th></th></tr></thead>
        <tbody>
        {{#each treasureItems}}
        <tr data-item-id="{{id}}">
          <td class="left"><a data-action="itemEdit">{{name}}</a></td>
          <td class="left hint">{{kind}}</td>
          <td>{{> "systems/frpg1e/templates/actor/parts/loc-select.hbs" opts=locOpts}}</td>
          <td><input type="number" class="w3" data-item-field="system.quantity" data-dtype="Number" value="{{s.quantity}}"></td>
          <td><input type="number" class="w5" data-item-field="system.value" data-dtype="Number" value="{{s.value}}"></td>
          <td class="num">{{totalText}}</td>
          <td><button type="button" class="icon-btn" data-action="itemDelete"><i class="fa-solid fa-trash"></i></button></td>
        </tr>
        {{else}}<tr><td colspan="7" class="hint">No gems or jewelry.</td></tr>{{/each}}
        </tbody>
      </table>
    </div>

    <div class="box gear-list">
      <h3 class="box-title">Possessions
        <button type="button" class="mini" data-action="itemCreate" data-type="gear" title="Add item"><i class="fa-solid fa-plus"></i></button>
      </h3>
      <table class="ledger">
        <thead><tr><th class="left">Item</th><th>Location</th><th>Qty</th><th>Weight (gp)</th><th class="left">Cost</th><th class="left">Notes</th><th></th></tr></thead>
        <tbody>
        {{#each gear}}
        <tr data-item-id="{{id}}">
          <td class="left"><a data-action="itemEdit">{{name}}</a>{{#if cont}}<span class="sub-note cont-load {{#if cont.over}}over{{/if}}" title="{{cont.contents}}">holds {{cont.loadText}}{{#if cont.over}}: over capacity{{/if}}</span>{{/if}}</td>
          <td>{{> "systems/frpg1e/templates/actor/parts/loc-select.hbs" opts=locOpts}}</td>
          <td><input type="number" class="w4" data-item-field="system.quantity" data-dtype="Number" value="{{system.quantity}}"></td>
          <td>{{#if (adnd-eq system.weightSource "unspecified")}}<input type="number" step="any" class="w4 wt-unknown" data-item-field="system.weight" data-dtype="Number" value="" placeholder="?" title="No published weight. Not counted until you enter one. {{system.weightRef}}">{{else}}<input type="number" step="any" class="w4" data-item-field="system.weight" data-dtype="Number" value="{{system.weight}}" title="{{system.weightRef}}">{{/if}}</td>
          <td class="left hint">{{system.cost}}</td>
          <td class="left"><input type="text" class="notes-in" data-item-field="system.notes" value="{{system.notes}}"></td>
          <td><button type="button" class="icon-btn" data-action="itemDelete"><i class="fa-solid fa-trash"></i></button></td>
        </tr>
        {{else}}<tr><td colspan="7" class="hint">Nothing carried.</td></tr>{{/each}}
        </tbody>
      </table>
      <p class="enc">Load <strong>{{system.encLoad}}</strong> gp (about {{encLoadLbs}} lb): worn {{system.encByLoc.worn}} gp, carried {{system.encByLoc.carried}} gp, coins {{system.encCoins}}. Strength weight allowance {{adnd-signed system.mods.str.wt}} gp.{{#if system.encUnknown}}<br><span class="wt-unknown-note">Not counted, no weight yet: {{system.encUnknownNames}}. Set a weight on the item (a Bag of Holding gets one from its “when found” roll).</span>{{/if}}{{#if system.encByLoc.mount}}<br>Marked “on mount” (old choice; pick the animal): <strong>{{system.encByLoc.mount}}</strong> gp, not counted.{{/if}}{{#if storedTotal}}<br>Stored elsewhere: {{system.encByLoc.stored}} gp of items, {{system.encCoinsStored}} coins (not counted).{{/if}}</p>
      {{#if encOn}}<p class="enc enc-status"><strong>{{system.enc.label}}</strong> ({{encRuleLabel}}): movement {{#if (adnd-eq system.enc.move 0)}}none{{else}}{{system.enc.move}}&Prime;{{/if}}{{#if encSlowed}}, slower than the {{system.move.armor}}&Prime; allowed by armor{{/if}}; {{system.enc.note}}.<br><span class="hint">Limits: {{system.enc.limits}}.</span></p>{{/if}}
    </div>
    <div class="box animals-list">
      <h3 class="box-title">Animals &amp; Transport <span class="hint">(not carried; set an item's Location to an animal or vehicle to load it)</span></h3>
      <table class="ledger">
        <thead><tr><th class="left">Animal or transport</th><th title="Load carried / normal load (maximum load), WSG Tables 13-14">Load</th><th>Qty</th><th class="left">Cost</th><th class="left">Notes (name…)</th><th></th></tr></thead>
        <tbody>
        {{#each animals}}
        <tr data-item-id="{{id}}">
          <td class="left"><a data-action="itemEdit">{{name}}</a></td>
          <td class="num cont-load {{#if cont.over}}over{{/if}} {{#if cont.overMax}}overmax{{/if}}" title="{{#if cont.overMax}}Over its maximum load (WSG Tables 13-14){{else}}{{#if cont.over}}Over its normal load: encumbered movement rate (WSG Table 13){{/if}}{{/if}}">{{#if cont}}{{cont.loadText}}{{/if}}</td>
          <td><input type="number" class="w4" data-item-field="system.quantity" data-dtype="Number" value="{{system.quantity}}"></td>
          <td class="left hint">{{system.cost}}</td>
          <td class="left"><input type="text" class="notes-in" data-item-field="system.notes" value="{{system.notes}}"></td>
          <td><button type="button" class="icon-btn" data-action="itemDelete"><i class="fa-solid fa-trash"></i></button></td>
        </tr>
        {{else}}<tr><td colspan="6" class="hint">Drag livestock and transport here from the Equipment (PHB) compendium.</td></tr>{{/each}}
        </tbody>
      </table>
    </div>
  

    <div class="box will-box">
      <h3 class="box-title">Will</h3>
      <div class="will-line">
        <span class="will-script">I</span>
        <input type="text" class="will-name" name="system.details.willName" value="{{system.details.willName}}" placeholder="{{actor.name}}">
        <span class="will-script">do hereby</span>
        <textarea class="will-text" name="system.details.willText" rows="1" placeholder="bequeath…">{{system.details.willText}}</textarea>
      </div>
    </div>

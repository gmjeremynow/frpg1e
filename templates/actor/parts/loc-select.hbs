<select class="loc-select" data-item-field="system.location" title="Where it is. Worn and carried count toward your load; stored items, and anything on an animal or vehicle, do not. Items in a container count where the container is.">
  {{#each opts}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
</select>

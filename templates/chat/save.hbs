<div class="frpg1e-card save-card">
  <div class="card-title">{{title}}</div>
  <div class="roll-line">
    <span class="die">{{natural}}</span>{{#each mods}}<span class="mod" title="{{label}}">{{text}}</span>{{/each}}
    <span class="eq">=</span><span class="adnd-big">{{total}}</span><span class="vs">vs {{target}}</span>
  </div>
  {{#if mods.length}}<div class="mod-list">{{#each mods}}{{label}} {{text}}{{#unless @last}}, {{/unless}}{{/each}}</div>{{/if}}
  <div class="result {{#if success}}hit{{else}}miss{{/if}}">{{#if success}}SAVED{{else}}FAILED{{/if}}{{#if autoFail}} (natural 1){{/if}}</div>
</div>
